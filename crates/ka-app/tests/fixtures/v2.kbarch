{
  "schema_version": 2,
  "id": "v2-sample",
  "name": "Saved by M1-M3 (v2): every card holds every default",
  "problem_id": null,
  "nodes": [
    {
      "id": "client",
      "kind": "client",
      "flavour": "web",
      "label": "",
      "position": { "x": 0, "y": 0 },
      "props": { "rps": 1000 },
      "group_id": null
    },
    {
      "id": "lb",
      "kind": "lb",
      "flavour": "nginx",
      "label": "",
      "position": { "x": 240, "y": 0 },
      "props": { "instances": 1, "algorithm": "ip_hash", "service_ms": 0.5 },
      "group_id": null
    },
    {
      "id": "api",
      "kind": "app",
      "flavour": "django",
      "label": "API",
      "position": { "x": 480, "y": 0 },
      "props": { "instances": 4, "concurrency": 64, "service_ms": 20 },
      "group_id": "web-tier"
    },
    {
      "id": "cache",
      "kind": "cache",
      "flavour": "redis",
      "label": "",
      "position": { "x": 720, "y": -120 },
      "props": { "memory_gb": 8, "ttl_s": 300, "eviction": "lru", "persistence": false, "service_ms": 0.5, "failover_s": 15 },
      "group_id": null
    },
    {
      "id": "db",
      "kind": "sql",
      "flavour": "mysql",
      "label": "",
      "position": { "x": 720, "y": 0 },
      "props": { "shards": 1, "concurrency": 100, "service_ms": 5, "replication_lag_ms": 50, "failover_s": 30 },
      "group_id": null
    },
    {
      "id": "jobs",
      "kind": "queue",
      "flavour": "sqs",
      "label": "",
      "position": { "x": 720, "y": 160 },
      "props": { "max_depth": 100000, "visibility_timeout_s": 60, "max_retries": 3 },
      "group_id": null
    },
    {
      "id": "worker",
      "kind": "worker",
      "flavour": "sidekiq",
      "label": "",
      "position": { "x": 960, "y": 160 },
      "props": { "instances": 2, "concurrency": 8, "service_ms": 100 },
      "group_id": null
    },
    {
      "id": "thumbs",
      "kind": "serverless",
      "flavour": "cloud_run",
      "label": "",
      "position": { "x": 960, "y": 320 },
      "props": { "concurrency_limit": 1000, "cold_start_ms": 500, "service_ms": 20 },
      "group_id": null
    }
  ],
  "edges": [
    { "id": "e1", "from": "client", "to": "lb", "protocol": "http" },
    { "id": "e2", "from": "lb", "to": "api", "protocol": "http" },
    { "id": "e3", "from": "api", "to": "cache", "protocol": "query" },
    { "id": "e4", "from": "api", "to": "db", "protocol": "query" },
    { "id": "e5", "from": "api", "to": "jobs", "protocol": "publish" },
    { "id": "e6", "from": "jobs", "to": "worker", "protocol": "consume" }
  ],
  "groups": [
    {
      "id": "web-tier",
      "kind": "autoscale",
      "label": "",
      "position": { "x": 440, "y": -40 },
      "size": { "w": 300, "h": 140 },
      "parent_id": null,
      "scaling": {
        "flavour": "kubernetes_hpa",
        "props": { "min_instances": 2, "max_instances": 12, "target_util": 60, "scale_delay_s": 60 }
      }
    }
  ],
  "notes": [],
  "viewport": { "x": 0, "y": 0, "zoom": 1 }

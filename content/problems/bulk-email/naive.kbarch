        "y": 170
      },
      "props": {},
      "group_id": null
    },
    {
      "id": "senders",
      "kind": "worker",
      "flavour": "celery",
      "label": "Mail senders",
      "position": {
        "x": 260,
        "y": 340
      },
      "props": {
        "instances": 4,
        "concurrency": 64
      },
